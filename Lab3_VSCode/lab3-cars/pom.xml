<?xml version="1.0" encoding="UTF-8"?>
<!-- Файл конфигурации Maven-проекта лабораторной работы №3 (вариант 5) -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Координаты проекта: группа, имя артефакта и версия -->
  <groupId>by.gstu.zhigar</groupId>
  <artifactId>lab3-cars</artifactId>
  <version>1.0</version>
  <!-- Результат сборки — jar-архив -->
  <packaging>jar</packaging>

  <name>lab3-cars</name>
  <description>Иерархия классов Car, SovietCar, Driver, Engine (ВвРПО, лабораторная работа №3)</description>

  <properties>
    <!-- Кодировка исходных файлов (нужна для русских комментариев и строк) -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Версия Java, под которую компилируется проект -->
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- BOM-файл JUnit 5: задаёт согласованные версии модулей JUnit -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.11.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- JUnit 5 — фреймворк для модульного тестирования (только для тестов) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Компиляция исходного кода -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <!-- Запуск модульных тестов на фазе test -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.0</version>
      </plugin>
      <!-- Упаковка классов в jar; в манифест записывается главный класс,
           чтобы jar можно было запустить командой java -jar -->
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>by.gstu.zhigar.lab3.App</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- Генерация документации JavaDoc (mvn javadoc:javadoc) -->
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <encoding>UTF-8</encoding>
          <docencoding>UTF-8</docencoding>
          <charset>UTF-8</charset>
          <show>private</show>
        </configuration>
      </plugin>
      <!-- Очистка каталога target (mvn clean) -->
      <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.4.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.1.2</version>
      </plugin>
    </plugins>
  </build>
</project>
